const HARI_KAL = { ph: 6, ec: 6, pulsa_peristaltik: 9 };
function kalibrasiContoh(baris, sekarang = Date.now()) {
  const hari = HARI_KAL[baris.sensor];
  const dasar = { ...baris, konstanta: null, perangkat_kode: null, perangkat_nama: 'Alat contoh', terakhir_terlihat: iso(sekarang - 3000), perangkat_online: true };
  if (hari == null) return dasar;
  const t = sekarang - hari * HARI;
  return { ...dasar, terakhir_dikalibrasi: iso(t), log_terakhir: { dilakukan_pada: iso(t), lulus: true, oleh_label: 'Admin contoh' } };
}

