/** Titik riwayat per interval (sama bentuknya dengan GET /monitoring/riwayat). */
function riwayat(dariMs, sampaiMs, intervalDetik) {
  const langkah = intervalDetik * 1000;
  const titik = [];
  for (let b = Math.floor(dariMs / langkah) * langkah; b <= sampaiMs && titik.length < 1500; b += langkah) {
    titik.push({ waktu: iso(b), ...nilaiPada(b + langkah / 2), n: Math.max(1, Math.round(langkah / LAMA_BACAAN)) });
  }
  return titik;
}

/** Baris bacaan mentah berhalaman (sama bentuknya dengan GET /monitoring/tarik). */
function tarik({ dari, sampai, page, limit, sekarang = Date.now() }) {
  const akhir = sampai && Number.isFinite(Date.parse(sampai)) ? Math.min(Date.parse(sampai), sekarang) : sekarang;
  const awal = dari && Number.isFinite(Date.parse(dari)) ? Date.parse(dari) : akhir - HARI;
  const total = Math.max(0, Math.min(20_000, Math.floor((akhir - awal) / LAMA_BACAAN)));
  const data = [];
  for (let i = (page - 1) * limit; i < Math.min(total, page * limit); i += 1) {
    const t = akhir - i * LAMA_BACAAN;
    data.push({ id: 100000 - i, ...nilaiPada(t), id_meja: null, created_at: iso(t), updated_at: iso(t) });
  }
  return { dari, sampai, data, total, page, per_page: limit };
}

/** Seri pH/TDS per menit untuk saran nutrisi (sama bentuknya dengan baris `monitorings` yang dibaca saran-dosis). */
function seriMentah(jam, sekarang = Date.now()) {
  const n = Math.min(1500, Math.max(1, Math.round(jam * 60)));
  const hasil = [];
  for (let i = n - 1; i >= 0; i -= 1) {
    const t = sekarang - i * 60_000;
    const v = nilaiPada(t);
    hasil.push({ ph: v.ph, tds: v.tds, created_at: iso(t) });
  }
  return hasil;
}

function chartData(sekarang = Date.now()) {
  const baris = [];
  for (let i = 287; i >= 0; i -= 1) {
    const t = sekarang - i * 300_000;
    baris.push({ id: 100000 - i, ...nilaiPada(t), id_meja: null, created_at: iso(t), updated_at: iso(t) });
  }
  return baris;
}

/** Grafik Nutrisi: ppm aktual per jam, tanpa target/dosing (tidak ada batch pada demo). */
function nutrisi(hari = 7, sekarang = Date.now()) {
  const h = Math.min(14, Math.max(1, Math.round(Number(hari)) || 7));
  const aktual = [];
  for (let t = Math.floor((sekarang - h * HARI) / 3_600_000) * 3_600_000; t <= sekarang; t += 3_600_000) {
    aktual.push({ t, ppm: nilaiPada(t).tds });
  }
  return {
    batch: null, alat: null, dari: sekarang - h * HARI, sampai: sekarang, sekarang,
    aktual, target_alat: [], rencana: [], dosing: [],
    hari_ini: { target_batch: null, target_alat: null, ppm_aktual: nilaiPada(sekarang).tds, ppm_segar: true, dosing: { AB: 0, PH: 0, ENCER: 0 } },
  };
}

/** Peringatan contoh: satu yang sedang terjadi dan beberapa riwayat yang sudah pulih. */
function peringatan(sekarang = Date.now()) {
  const menit = 60_000;
  const baris = (id, type, value, severity, mulai, selesai) => ({
    id, type, value, severity, locked: false, acknowledged: selesai != null, acknowledged_at: selesai != null ? iso(selesai) : null,
    created_at: iso(mulai), updated_at: iso(selesai ?? mulai), kunci_kejadian: `contoh_${id}`, selesai_pada: selesai != null ? iso(selesai) : null,
    sedang_terjadi: selesai == null,
  });
  return [
    baris(9001, 'Kelembapan', 'Kelembapan 38% di bawah batas aman 40–100%', 'warning', sekarang - 25 * menit, null),
    baris(9002, 'pH', 'pH 7,12 di atas batas aman 5,00–7,00', 'warning', sekarang - 6 * 3_600_000, sekarang - 5.5 * 3_600_000),
    baris(9003, 'Suhu udara', 'Suhu udara 41,3 °C di atas batas aman 20,0–40,0 °C', 'warning', sekarang - 28 * 3_600_000, sekarang - 27 * 3_600_000),
    baris(9004, 'Alat offline', 'Alat tidak terhubung ke server: cek listrik dan Wi-Fi alat', 'warning', sekarang - 40 * 3_600_000, sekarang - 39.8 * 3_600_000),
    baris(9005, 'Nutrisi', 'Nutrisi 410 ppm di bawah batas aman 500–1600 ppm', 'critical', sekarang - 52 * 3_600_000, sekarang - 51 * 3_600_000),
  ];
}

function alertLogs(limit, sekarang = Date.now()) {
  const semua = peringatan(sekarang);
  const aktif = semua.filter((r) => r.sedang_terjadi).length;
  return { status: true, data: semua.slice(0, limit), total: semua.length, aktif };
}

function alertRiwayat({ page, perPage, severity }, sekarang = Date.now()) {
  const selesai = peringatan(sekarang).filter((r) => !r.sedang_terjadi && (severity == null || r.severity === severity));
  const data = selesai.slice((page - 1) * perPage, page * perPage)
    .map(({ id, type, value, severity: s, acknowledged, created_at, kunci_kejadian, selesai_pada }) => ({ id, type, value, severity: s, acknowledged, created_at, kunci_kejadian, selesai_pada }));
  return { status: true, data, total: selesai.length, page, per_page: perPage };
}


/* ───────── Analisis Data: pengganti pembacaan DB (dipakai lewat AsyncLocalStorage di routes/analisis.js) ───────── */
function bacaanLimaMenit(dariIso, sampaiIso) {
  const awal = Date.parse(dariIso), akhir = Date.parse(sampaiIso), langkah = 300_000, hasil = [];
  for (let b = Math.floor(awal / langkah) * langkah; b <= akhir && hasil.length < 27_000; b += langkah) {
    const v = nilaiPada(b + langkah / 2);
    hasil.push({ waktu: iso(b), t: b, ph: v.ph, tds: v.tds, waterTemp: v.waterTemp, ec: v.ec_ms_cm, airTemp: v.airTemp, humidity: v.humidity });
  }
  return hasil;
}

function kejadianDosing(dariIso, sampaiIso) {
  const awal = Date.parse(dariIso), akhir = Date.parse(sampaiIso);
  const kejadian = waktuDosingAB(awal, akhir).map((t) => ({ t, jenis: 'AB' }));
  for (let hari = Math.floor(awal / HARI) * HARI; hari <= akhir; hari += 2 * HARI) {
    const t = hari + 2 * 3_600_000; // 10.00 WITA, dua hari sekali
    if (t >= awal && t <= akhir) kejadian.push({ t, jenis: 'PH' });
  }
  return kejadian.sort((x, y) => x.t - y.t);
}

