'use strict';
/**
 * Data contoh untuk akun demo ("Coba Akun Demo"): sintetis, deterministik, TIDAK diambil dari kebun asli.
 * Dipakai oleh dashboard, monitoring, peringatan, dan gambar CCTV supaya demo tampil hidup tanpa membuka data nyata.
 * Tidak menyentuh database dan tidak punya efek samping.
 */
const HARI = 86_400_000;
const LAMA_BACAAN = 9_000; // satu bacaan tiap 9 detik, seperti alat sungguhan

/** Derau semu deterministik: waktu yang sama selalu menghasilkan nilai yang sama (tanpa Math.random). */
function derau(ms, benih) {
  const x = Math.sin((ms / 1000) * 12.9898 + benih * 78.233) * 43758.5453;
  return (x - Math.floor(x)) * 2 - 1;
}

const bulat = (n, d) => Number(n.toFixed(d));

/** Waktu dosing A+B contoh (UTC): 08.00 dan 23.30 tiap hari = 16.00 dan 07.30 WITA. */
const DOSING_UTC_JAM = [8, 23.5];
function waktuDosingAB(dariMs, sampaiMs) {
  const hasil = [];
  for (let hari = Math.floor(dariMs / HARI) * HARI - HARI; hari <= sampaiMs; hari += HARI) {
    for (const jam of DOSING_UTC_JAM) {
      const t = hari + jam * 3_600_000;
      if (t >= dariMs && t <= sampaiMs) hasil.push(t);
    }
  }
  return hasil;
}

/** Kenaikan ppm sesaat sesudah dosing A+B, lalu meluruh (supaya analisis respons dosing punya sinyal). */
function efekDosing(ms) {
  let efek = 0;
  for (const e of waktuDosingAB(ms - 6 * 3_600_000, ms)) {
    const dt = (ms - e) / 1000;
    efek += 55 * Math.min(1, dt / 1800) * Math.exp(-dt / 10_800);
  }
  return efek;
}

/** Nilai kelima sensor pada waktu tertentu (ms epoch). Selalu di dalam batas aman. */
function nilaiPada(ms) {
  const pecahan = (((ms / 1000 + 8 * 3600) % 86400) + 86400) % 86400 / 86400; // jam lokal WITA
  const siang = Math.sin(2 * Math.PI * (pecahan - 0.3));
  const ph = 6.0 + 0.18 * Math.sin((2 * Math.PI * ms) / (HARI * 1.7)) + 0.04 * derau(ms, 1);
  const tds = 1000 + 30 * Math.sin((2 * Math.PI * ms) / (HARI * 0.5) + 1) + 6 * derau(ms, 2) + efekDosing(ms);
  return {
    ph: bulat(ph, 2),
    tds: Math.round(tds),
    ec_ms_cm: bulat(tds / 500, 2),
    waterTemp: bulat(26 + 1.8 * siang + 0.1 * derau(ms, 3), 1),
    airTemp: bulat(29 + 5 * siang + 0.3 * derau(ms, 4), 1),
    humidity: Math.round(74 - 10 * siang + 0.8 * derau(ms, 5)),
  };
}

const iso = (ms) => new Date(ms).toISOString();

function bacaanTerbaru(sekarang = Date.now()) {
  const t = Math.floor((sekarang - 3000) / 1000) * 1000;
  return { id: 1, ...nilaiPada(t), id_meja: null, created_at: iso(t), updated_at: iso(t) };
}

function rataRata(sekarang = Date.now()) {
  const n = 40;
  const jumlah = { ph: 0, tds: 0, waterTemp: 0, airTemp: 0, humidity: 0 };
  for (let i = 0; i < n; i += 1) {
    const v = nilaiPada(sekarang - (i * 6 * 3_600_000) / n);
    Object.keys(jumlah).forEach((k) => { jumlah[k] += v[k]; });
  }
  return {
    waterTemp: bulat(jumlah.waterTemp / n, 2), ph: bulat(jumlah.ph / n, 2), tds: bulat(jumlah.tds / n, 2),
    airTemp: bulat(jumlah.airTemp / n, 2), humidity: bulat(jumlah.humidity / n, 2), jumlah: Math.round((6 * 3_600_000) / LAMA_BACAAN),
  };
}

