!deploy-pi/firmware/aktuator/rahasia.h.contoh
!deploy-pi/firmware/sensor/sensor.ino
!deploy-pi/firmware/sensor/rahasia.h.contoh
!deploy-pi/firmware/gabungan/gabungan.ino
!deploy-pi/firmware/gabungan/rahasia.h.contoh
scripts/

