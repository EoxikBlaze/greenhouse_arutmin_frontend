#pragma once

// Daftar Wi-Fi 2,4 GHz yang dicoba otomatis (dipilih sinyal terkuat yang tersedia).
// Modem baru: boleh set Wi-Fi modem ke "VertonikModem", atau tambah dinamis via Serial: wifi NAMA|SANDI.
#define WIFI_JARINGAN { \
  { "VertonikModem",     "SANDI_MODEM" }, \
  { "Pokjar Permata",    "SANDI_POKJAR" }, \
  { "Biruni",            "SANDI_BIRUNI" }, \
  { "Rumah Permata",     "SANDI_RUMAH_PERMATA" }, \
  { "WALAWE",            "SANDI_HOTSPOT_HP" }, \
  { "Vertoniksmartfarm", "SANDI_HOTSPOT_PI" } \
}

// Cadangan bila mDNS (garap.local / vertonik.local / vertonic.local) & probe subnet tidak ketemu.
#define SERVER_IP   "192.168.0.100"

// ID meja/penampung dari menu Meja di web (0 = tersimpan sebagai bacaan umum; >= 1 = penampung tertentu)
#define ID_MEJA     0

// Satu ESP32 = satu login 'aktuator-01' dari /etc/vertonik/kunci-perangkat.txt di Pi.
#define API_KEY_AKTUATOR "vsf_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
