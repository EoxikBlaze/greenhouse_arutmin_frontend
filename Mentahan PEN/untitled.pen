                      "name": "Card Line",
                      "fill": "#3A3F44",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  tabel: th + scope kolom, caption; pagination: aria-label Halaman N + aria-current pada halaman aktif.",
