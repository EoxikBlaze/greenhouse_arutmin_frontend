                      "fontFamily": "Roboto Mono",
                      "fontSize": 10.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "IMCcV",
                      "name": "Card Line",
                      "fill": "#3A3F44",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Status TIDAK disampaikan lewat warna saja: selalu ada label teks (Normal / Di bawah target / Periksa Alat / Alat Terputus) plus bentuk atau ikon.",
                      "lineHeight": 1.55,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 10.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "WewmJ",
                      "name": "Card Line",
                      "fill": "#3A3F44",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Tag status pada metric card dan badge topbar memakai teks solid, bukan sekadar latar berwarna.",
                      "lineHeight": 1.55,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 10.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "t1em0",
                      "name": "Card Line",
                      "fill": "#3A3F44",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Placeholder, teks bantu, dan timestamp tetap ≥ 4,5:1 — hindari abu-abu terlalu muda.",
