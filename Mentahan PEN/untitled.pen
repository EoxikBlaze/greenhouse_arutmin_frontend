                      "fontFamily": "Roboto Mono",
                      "fontSize": 10.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "YJxqK",
                      "name": "Card Line",
                      "fill": "#3A3F44",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Fokus terlihat jelas: outline setara kontras ≥ 3:1 terhadap latar di sekitarnya.",
